# Local test-only values for the throwaway sandb-test containers.
# These are NOT real secrets. Never reuse them anywhere else.
# Host ports: compose.yaml, up.sh, wait.sh and the integration tests all read them here.
PG16_PORT=55416
PG13_PORT=55413
MYSQL_PORT=53384
MARIADB_PORT=53311
MONGO_RS_PORT=57017
MONGO_STANDALONE_PORT=57018
MOCK_LLM_PORT=58080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sandb_test_root
POSTGRES_DB=shop
MYSQL_ROOT_PASSWORD=sandb_test_root
MARIADB_ROOT_PASSWORD=sandb_test_root
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=sandb_test_root
# App users. The seed SQL files hard-code the same passwords.
SANDB_RW_USER=sandb_rw
SANDB_RW_PASSWORD=sandb_rw_pw
SANDB_RO_USER=sandb_ro
SANDB_RO_PASSWORD=sandb_ro_pw
# Optional: set to require "Authorization: Bearer <key>" on the mock LLM.
MOCK_LLM_KEY=
